# ═══════════════════════════════════════════════════════════════════════════
# Global Supply Chain Index — API Keys
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your keys.
# FRED is free. Anthropic (optional) is billed per use.
#
# NOTE: The other sources (Open-Meteo, IMF PortWatch, Treasury, GDACS, USGS,
# USDA AgTransport, the GPR and TPU files) need no key.
# ═══════════════════════════════════════════════════════════════════════════

# ── FRED (Federal Reserve Economic Data) ──────────────────────────────────
# Powers the FRED series behind energy, tariffs, freight, input costs and CPI.
# Optional: without a key the public CSV download is used.
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
# Cost: FREE, unlimited requests
FRED_API_KEY=



# ── Anthropic (Claude) ────────────────────────────────────────────────────
# Powers: headline severity, AI briefing, daily report, port summaries and the
# disruption register. None of these feed a category score. Optional: without
# it headlines show unscored and the briefing is deterministic text.
# Get a key: https://platform.claude.com/settings/keys
# Optional overrides: ANTHROPIC_MODEL (default claude-sonnet-5-5),
# ANTHROPIC_EFFORT (default medium), AI_CACHE_TTL_SECONDS (default 86400)
ANTHROPIC_API_KEY=

# ── Admin + newsletter ─────────────────────────────────────────────────────
# ADMIN_TOKEN protects /api/v1/newsletter-data and /api/v1/admin/* (sent as
# "Authorization: Bearer <token>"). NEWSLETTER_SECRET signs unsubscribe links
# (falls back to ADMIN_TOKEN). CAN-SPAM requires a postal address in the
# newsletter footer.
ADMIN_TOKEN=
NEWSLETTER_SECRET=
NEWSLETTER_POSTAL_ADDRESS=
