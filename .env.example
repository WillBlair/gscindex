# ═══════════════════════════════════════════════════════════════════════════
# Global Supply Chain Index — API Keys
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your keys.
# FRED and NewsAPI are free. Anthropic (optional) is billed per use.
#
# NOTE: Weather uses Open-Meteo which requires NO key at all.
# ═══════════════════════════════════════════════════════════════════════════

# ── FRED (Federal Reserve Economic Data) ──────────────────────────────────
# Powers: Energy, Tariffs, Shipping, Ports, Demand (5 of 7 categories)
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
# Cost: FREE, unlimited requests
FRED_API_KEY=



# ── NewsAPI ───────────────────────────────────────────────────────────────
# Powers: Geopolitical Risk category + Alerts feed
# Sign up: https://newsapi.org/register
# Cost: FREE tier = 100 requests/day
NEWSAPI_KEY=

# ── Anthropic (Claude) ────────────────────────────────────────────────────
# Powers: news severity analysis, AI briefing, daily report, port summaries,
# score explanation. Optional: without it everything falls back to VADER and
# deterministic text.
# Get a key: https://platform.claude.com/settings/keys
# Optional overrides: ANTHROPIC_MODEL (default claude-sonnet-5-5),
# ANTHROPIC_EFFORT (default medium), AI_CACHE_TTL_SECONDS (default 86400)
ANTHROPIC_API_KEY=

# ── Admin + newsletter ─────────────────────────────────────────────────────
# ADMIN_TOKEN protects /api/v1/newsletter-data and /api/v1/admin/* (sent as
# "Authorization: Bearer <token>"). NEWSLETTER_SECRET signs unsubscribe links
# (falls back to ADMIN_TOKEN). CAN-SPAM requires a postal address in the
# newsletter footer.
ADMIN_TOKEN=
NEWSLETTER_SECRET=
NEWSLETTER_POSTAL_ADDRESS=
